# Environment configuration for RaktDrishti Platform

# Application Mode
ENVIRONMENT=development
DEBUG=True
APP_NAME=RaktDrishti
API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL in production / SQLite for local development)
DATABASE_URL=sqlite:///./raktdrishti.db
# DATABASE_URL=postgresql://raktdrishti:raktdrishti_secret@localhost:5432/raktdrishti_db

# Security & Authentication
JWT_SECRET=raktdrishti_super_secure_jwt_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Firebase Configuration (Optional / Identity integration)
FIREBASE_PROJECT_ID=raktdrishti-biotech-2026
FIREBASE_STORAGE_BUCKET=raktdrishti-biotech-2026.appspot.com
FIREBASE_CREDENTIALS_PATH=

# Backend API Configuration
API_BASE_URL=http://localhost:8000/api/v1
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080","http://127.0.0.1:8000","*"]

# ML & Calibration Configuration
MODEL_PATH=ml/demo_model/raktdrishti_anemia_v1.tflite
MODEL_VERSION=v1.0.0-mvp-demo
CALIBRATION_CONFIDENCE_THRESHOLD=0.70
IMAGE_QUALITY_THRESHOLD=60.0

# Storage
LOCAL_STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=10
